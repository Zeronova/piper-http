# ── Piper Stack-Konfiguration ────────────────────────────────
# Portainer: wird automatisch geladen bei Deploy via Repository.
# Lokal:     Kopieren nach .env – docker compose liest es automatisch.
#
# Mit "Stack" → Pi Environment variables" im Portainer-UI
# können einzelne Werte überschrieben werden.

# ── Port & Volume ────────────────────────────────────────────
PIPER_PORT=5000
PIPER_MODELS_DIR=/appdata/models

# ── Model ────────────────────────────────────────────────────
MODEL_DOWNLOAD_LINK=https://huggingface.co/rhasspy/piper-voices/resolve/main/de/de_DE/thorsten/high/de_DE-thorsten-high.onnx?download=true
MODEL_DEFAULT=de_DE-thorsten-high
MODEL_TARGET_FOLDER=/app/models

# ── TTS Parameter ────────────────────────────────────────────
SPEAKER=1
SENTENCE_SILENCE=0.5
LENGTH_SCALE=1
NOISE_SCALE=0.667
NOISE_W=0.8
CUDA=true
