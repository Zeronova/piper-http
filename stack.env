# ── Piper Docker-Compose Variablen ──────────────────────────
# Wird von Portainer automatisch geladen (stack.env).
# Überschreibbar via Portainer-UI "Environment variables".

# Port auf dem Host (z.B. 5000 → localhost:5000)
PIPER_PORT=5000

# Lokaler Pfad für Model-Downloads (wird gemountet nach /app/models)
PIPER_MODELS_DIR=/appdata/models
