# ── Piper TTS Konfiguration ──────────────────────────────────
# Dieses File wird von docker-compose via env_file eingelesen.

# Initiales Model (wird beim Start geladen)
MODEL_DOWNLOAD_LINK=https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/de/de_DE/jarvis/high/de_DE-jarvis-high.onnx?download=true

# Standard-Model (für Web-UI / Reset)
MODEL_DEFAULT=https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/de/de_DE/jarvis/high/de_DE-jarvis-high.onnx?download=true

# Zielordner für Model-Downloads
MODEL_TARGET_FOLDER=/app/models

# Speaker-ID (0 = erste/default Stimme)
SPEAKER=0

# ── TTS Parameter ────────────────────────────────────────────
# Pause zwischen Sätzen in Sekunden (endlich richtig lange Pausen!)
SENTENCE_SILENCE=1.5

# Phonem-Länge (Piper-default wenn leer)
LENGTH_SCALE=1.1

# Generator-Noise (Piper-default wenn leer)
NOISE_SCALE=0.667

# Phonem-Breiten-Noise (Piper-default wenn leer)
NOISE_W=0.8

# CUDA aktivieren (true = wenn verfügbar)
CUDA=true
