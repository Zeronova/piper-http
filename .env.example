# ── Piper Docker-Compose Variablen ──────────────────────────
# Kopiere diese Datei nach .env und passe die Werte an.
# Wird von docker-compose.yml per ${VAR:-default} verwendet.

# Port auf dem Host (z.B. 5000 → localhost:5000)
PIPER_PORT=5000

# Lokaler Pfad für Model-Downloads (wird gemountet nach /app/models)
PIPER_MODELS_DIR=./models
